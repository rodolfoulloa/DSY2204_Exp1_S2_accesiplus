# Reglas de R8 propias de AccesiPlus.
# AGP combina todos los archivos de src/main/keepRules y se los pasa a R8.
#
# Los modelos se convierten a Map a mano (data/model/Mapeo.kt), así que Firebase no necesita
# reflexión sobre ellos. Firebase, Room y Fragment traen sus propias reglas.

# AndroidFragment instancia el Fragment por nombre de clase (FragmentFactory): conservar su constructor
-keep class cl.duoc.rulloa.accesiplus.ui.devices.ConsejosFragment { public <init>(); }
