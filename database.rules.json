{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['name', 'email', 'createdAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
          "email": { ".validate": "newData.isString() && newData.val() === auth.token.email" },
          "role": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "gender": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$otro": { ".validate": false }
        },
        "phrases": {
          "$phraseId": {
            ".validate": "newData.hasChildren(['text', 'category', 'createdAt'])",
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
            "category": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "favorite": { ".validate": "newData.isBoolean()" },
            "uses": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "$otro": { ".validate": false }
          }
        },
        "devices": {
          "$deviceId": {
            ".validate": "newData.hasChildren(['name', 'type', 'createdAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60" },
            "type": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "notes": { ".validate": "newData.isString() && newData.val().length <= 300" },
            "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
            "lon": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
            "locationAt": { ".validate": "newData.isNumber()" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "$otro": { ".validate": false }
          }
        },
        "$otro": { ".validate": false }
      }
    }
  }
}
